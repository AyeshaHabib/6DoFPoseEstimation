{
  "expo": {
    "name": "Habib Hospital",
    "slug": "habib-hospital",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "habibhospital",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pk.habibhospital.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Habib Hospital uses your location only when you open directions."
      }
    },
    "android": {
      "package": "pk.habibhospital.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B3D3A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B3D3A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
